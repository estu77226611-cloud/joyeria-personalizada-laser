rules_version = '2';

/* Lúmina Joyería — reglas de Firestore.
   - pedidos/{codigo}: solo el administrador puede leer/listar datos personales.
   - seguimientos/{codigo}: lectura pública puntual con el código exacto; nunca listar.
   - comentarios/{id}: lectura pública; creación validada; borrado solo administrador.
   - admins/{uid}: el propio usuario autenticado puede comprobar su documento.
     Los documentos se crean a mano desde la consola de Firebase.

   Importante: al crear un pedido se escribe también su seguimiento público
   en el mismo writeBatch. Así el cliente recibe un código y puede consultar
   el estado sin exponer nombres, teléfonos, direcciones ni importes. */

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function exact(d, names) {
      return d.keys().hasOnly(names) && d.keys().hasAll(names);
    }

    function textMax(v, n) {
      return v is string && v.size() <= n;
    }

    function codeOK(c) {
      return c.matches('^LUM-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8}$');
    }

    /* Firestore Rules no permite recorrer listas: se valida la forma del
       primer artículo y los límites generales. La interfaz pinta todo con
       textContent, sin interpretar HTML. */
    function validItems(v) {
      return v is list
        && v.size() > 0
        && v.size() <= 40
        && v[0] is map
        && exact(v[0], ['id', 'nombre', 'precio', 'cantidad', 'grabado', 'acabado', 'nota'])
        && v[0].id is int
        && v[0].id > 0
        && textMax(v[0].nombre, 120)
        && v[0].precio is number
        && v[0].precio >= 0
        && v[0].cantidad is int
        && v[0].cantidad >= 1
        && v[0].cantidad <= 20
        && textMax(v[0].grabado, 60)
        && v[0].acabado in ['dorado', 'plateado']
        && textMax(v[0].nota, 300);
    }

    function validDelivery(v) {
      return v is map
        && exact(v, ['tipo', 'distrito', 'direccion', 'referencia', 'agencia', 'guia'])
        && v.tipo in ['recojo', 'delivery', 'shalom']
        && textMax(v.distrito, 80)
        && textMax(v.direccion, 200)
        && textMax(v.referencia, 200)
        && textMax(v.agencia, 120)
        && v.guia == '';
    }

    function validOrder(c) {
      let d = request.resource.data;
      return codeOK(c)
        && exact(d, [
          'codigo',
          'creado',
          'actualizado',
          'estado',
          'historial',
          'items',
          'total',
          'entrega',
          'cliente',
          'notas',
          'notasAdmin'
        ])
        && d.codigo == c
        && d.creado is number
        && d.actualizado == d.creado
        && d.estado == 'registrado'
        && d.historial is list
        && d.historial.size() == 1
        && d.historial[0] is map
        && exact(d.historial[0], ['estado', 'fecha', 'nota'])
        && d.historial[0].estado == 'registrado'
        && d.historial[0].fecha == d.creado
        && textMax(d.historial[0].nota, 400)
        && validItems(d.items)
        && d.total is number
        && d.total >= 0
        && validDelivery(d.entrega)
        && d.cliente is map
        && exact(d.cliente, ['nombre', 'telefono'])
        && textMax(d.cliente.nombre, 80)
        && d.cliente.nombre.size() >= 3
        && textMax(d.cliente.telefono, 20)
        && d.cliente.telefono.size() >= 6
        && textMax(d.notas, 400)
        && d.notasAdmin == '';
    }

    /* Documento público mínimo. Debe crearse junto al pedido privado y solo
       puede contener estado, fechas e historial sin notas libres. */
    function publicInitial(c) {
      let d = request.resource.data;
      let privateOrder = getAfter(/databases/$(database)/documents/pedidos/$(c)).data;
      return codeOK(c)
        && exact(d, ['codigo', 'creado', 'actualizado', 'estado', 'historial'])
        && d.codigo == c
        && d.estado == 'registrado'
        && d.creado is number
        && d.actualizado == d.creado
        && d.historial is list
        && d.historial.size() == 1
        && d.historial[0] is map
        && exact(d.historial[0], ['estado', 'fecha', 'nota'])
        && d.historial[0].estado == 'registrado'
        && d.historial[0].fecha == d.creado
        && d.historial[0].nota == 'Pedido recibido'
        && privateOrder.codigo == c
        && privateOrder.creado == d.creado
        && privateOrder.estado == d.estado;
    }

    match /pedidos/{codigo} {
      // No exponer nombres, teléfonos ni domicilios mediante un código.
      allow get, list: if isAdmin();

      // La creación debe incluir su documento público en la misma escritura atómica.
      allow create: if validOrder(codigo)
        && getAfter(/databases/$(database)/documents/seguimientos/$(codigo)).data.codigo == codigo
        && getAfter(/databases/$(database)/documents/seguimientos/$(codigo)).data.creado
          == request.resource.data.creado;

      allow update, delete: if isAdmin();
    }

    match /seguimientos/{codigo} {
      // Lectura individual por código, nunca enumeración pública.
      allow get: if codeOK(codigo);
      allow list: if isAdmin();
      allow create: if isAdmin() || publicInitial(codigo);
      allow update, delete: if isAdmin();
    }

    match /comentarios/{id} {
      allow read: if true;

      allow create: if exact(request.resource.data, ['nombre', 'texto', 'creado'])
        && textMax(request.resource.data.nombre, 40)
        && request.resource.data.nombre.size() >= 2
        && textMax(request.resource.data.texto, 280)
        && request.resource.data.texto.size() >= 2
        && request.resource.data.creado is number;

      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Bloquea cualquier colección no declarada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
